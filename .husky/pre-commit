#!/bin/sh

# Update submodules to latest
# Auto-stage submodule pointer changes in parent repo
git submodule status | awk '{print $2}' | xargs -r git add

# Regenerate workflow/action YAML files from source fixtures and stage for commit
node src/github-workflows/generate-ci-cli.mjs
if [ -n "$GITHUB_ACTIONS" ] || [ -n "$CI" ]; then
  echo "CI environment detected — skipping git add of generated action"
else
  git add .github/workflows/test.yml .github/actions/setup-environments/action.yml .github/workflows/build-release.yml
fi

# Run lint-staged through Yarn so the local binary is resolved consistently
corepack yarn exec lint-staged --config lint-staged.config.js

# Verify release tarballs do not exceed 10MB
check_tarballs() {
  dir="$1"
  if [ -d "$dir" ]; then
    for file in "$dir"/*.tgz; do
      [ -e "$file" ] || continue
      size_bytes=$(wc -c <"$file")
      if [ "$size_bytes" -gt $((10 * 1024 * 1024)) ]; then
        echo "Error: Tarball $file exceeds 10MB limit"
        exit 1
      fi
    done
  fi
}

check_tarballs release
check_tarballs releases