{
  "**/*.{js,cjs,mjs,ts,jsx,tsx}": ["set ESLINT_USE_FLAT_CONFIG=true && npx eslint --fix --max-warnings=0"],
  "**/*.json": "npx prettier --list-different --write",
  "**/*.css": "npx prettier --list-different --write",
  "**/*.scss": "npx prettier --list-different --write",
  "**/*.less": "npx prettier --list-different --write",
  "**/*.{yml,yaml}": "npx prettier --list-different --write",
  "**/*.php": "composer exec php-cs-fixer fix",
  "**/*.sql": "npx prettier --list-different --write",
  "**/*.py": "py -m black"
}
