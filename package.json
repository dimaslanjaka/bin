{
  "name": "binary-collections",
  "version": "2.0.15",
  "description": "Utility to clean any programming caches and more",
  "keywords": [
    "cache",
    "cleaner",
    "utility"
  ],
  "homepage": "https://www.webmanajemen.com/",
  "bugs": {
    "url": "https://github.com/dimaslanjaka/bin/issues"
  },
  "license": "MIT",
  "author": {
    "name": "dimaslanjaka",
    "email": "dimaslanjaka@gmail.com",
    "url": "https://webmanajemen.com"
  },
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "binaries/",
    "lib/",
    "docs-src/",
    ".puppeterrc.cjs",
    "requirements.txt"
  ],
  "scripts": {
    "build": "npm run build-tsup && npm run build-exports && npm run build-mainEntry",
    "build-exports": "node -r ts-node/register -r dotenv/config build.mjs",
    "build-packages": "yarn workspaces foreach --worktree --exclude=binary-collections --no-private run build",
    "build-rollup": "rollup -c rollup.config.js",
    "build-tsup": "node build.tsup.js",
    "build-ts": "tsc -p tsconfig.build.json",
    "build-dts": "tsc -p tsconfig.dts.json",
    "build-mainEntry": "npm run build-dts && rollup -c rollup.mainEntry.js",
    "clean": "npx -y rimraf lib tmp/dist binaries",
    "pack": "node src/node-package-packer-cli.mjs --yarn --filename=bin --normalize-resolutions",
    "prepare": "husky",
    "puppeteer:browser": "npx -y puppeteer browsers install chrome",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --testTimeout=120000 --detectOpenHandles --bail",
    "test-coverage": "npm test --coverage --detectOpenHandles",
    "test-esm": "test-esm",
    "test-nrs": "npm test -- nrs build-**",
    "test-root": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --testTimeout=120000 --detectOpenHandles --bail --roots test",
    "update:ncu": "npx npm-check-updates -u --enginesNode --root -x jest -x @types/jest -x babel-jest -x @babel/core -x @babel/preset-env -x @babel/preset-typescript -x ts-jest -x eslint -x @eslint/eslintrc -x @eslint/js -x @typescript-eslint/eslint-plugin -x @typescript-eslint/parser -x eslint-config-prettier -x eslint-plugin-prettier -x typescript-eslint -x prettier -x typescript -x ts-node -x @yarnpkg/core",
    "serve": "php -S 0.0.0.0:8490",
    "upload": "node scripts/upload-backend.mjs",
    "mkdocs-serve": "mkdocs serve -a \"0.0.0.0:5173\" --livereload"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimaslanjaka/bin"
  },
  "dependencies": {
    "@yarnpkg/core": "^4.8.0",
    "ansi-colors": "^4.1.3",
    "axios": "^1.17.0",
    "better-sqlite3": "^13.0.3",
    "cosmiconfig": "^9.0.2",
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/private/release/cross-spawn.tgz",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.5",
    "git-command-helper": "^2.1.1",
    "glob": "^13.0.6",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.5",
    "minimist": "^1.2.8",
    "moment-timezone": "^0.6.2",
    "openai": "^6.42.0",
    "pify": "^6.1.0",
    "proxy-agent": "^8.0.2",
    "ps-node": "^0.1.6",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sbg-utility": "https://github.com/dimaslanjaka/static-blog-generator/raw/44e5c7b79b4e60f8c2d34857c27b8ce677d7493e/packages/sbg-utility/release/sbg-utility.tgz",
    "tar-stream": "^3.2.0",
    "upath": "^3.0.7",
    "which": "^7.0.0",
    "yaml": "^2.9.0",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/plugin-syntax-import-assertions": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/traverse": "^8.0.4",
    "@dimaslanjaka/eslint-base-config": "^1.0.2",
    "@octokit/rest": "^22.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/babel__core": "^7",
    "@types/babel__preset-env": "^7",
    "@types/babel__traverse": "^7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4",
    "@types/fs-extra": "^11",
    "@types/jest": "^30.0.0",
    "@types/minimist": "^1",
    "@types/mocha": "^10.0.10",
    "@types/moment-timezone": "^0.5.30",
    "@types/node": "^25.9.3",
    "@types/ps-node": "^0",
    "@types/tar-stream": "^3",
    "@types/which": "^3.0.4",
    "babel-jest": "^30.4.1",
    "browser-sync": "^3.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "16.2.7",
    "marked": "^18.0.5",
    "rimraf": "^6.1.3",
    "rollup": "^4.61.1",
    "ssh2-sftp-client": "^12.1.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "directories": {
    "lib": "lib",
    "bin": "binaries"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@types/through2": "https://github.com/dimaslanjaka/nodejs-package-types/raw/refs/heads/through2/release/types-through2.tgz",
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/85a5399f99298c761dcd4b4aaf802dcfec502088/release/cross-spawn.tgz",
    "git-command-helper": "https://github.com/dimaslanjaka/git-command-helper/raw/028ef16009d7ba068d6214c68950773c90e1dfa6/release/git-command-helper.tgz",
    "sbg-utility": "https://github.com/dimaslanjaka/static-blog-generator/raw/1ca385787f7287155b547c5b97d5ffd5bcfab482/packages/sbg-utility/release/sbg-utility.tgz",
    "@dimaslanjaka/eslint-base-config": "https://github.com/dimaslanjaka/eslint-base-config/raw/38b2d13009cff91841d0cd36a161924df021fbc7/release/dimaslanjaka-eslint-base-config.tgz",
    "got": "11.8.2"
  }
}
