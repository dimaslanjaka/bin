{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2015",
    "module": "CommonJS",
    "outDir": "lib",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "allowJs": true
  },
  "include": ["./src/**/*"],
  "exclude": ["**/node_modules", "**/test*", "**/*.spec*.ts", "**/*.test*.ts"]
}
