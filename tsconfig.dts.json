{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "lib",
    "rootDir": "./src",
    "declarationMap": false,
    "allowJs": true,
    "moduleResolution": "bundler"
  },
  "include": ["./src/**/*"],
  "exclude": ["**/node_modules", "**/test*", "**/*.spec*.ts", "**/*.test*.ts"]
}
